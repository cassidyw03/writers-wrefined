{
  "name": "writers-wrefined",
  "version": "0.1.0",
  "private": true,
  "description": "Continuity checker for fantasy authors",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cassidyw03/writers-wrefined.git"
  },
  "author": "Cassidy Whitehead Mangum",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
