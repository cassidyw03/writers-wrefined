# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://user:password@host:5432/writers_wrefined

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site. Leave empty locally; in production use the static site's URL.
BETTER_AUTH_URL=

# AI services (server only; never expose to the browser)
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5
EXTRACTION_MODEL=
VOYAGE_API_KEY=

# Client (Vite exposes only VITE_* variables). Leave empty in local dev; the Vite proxy forwards /api.
VITE_API_URL=
